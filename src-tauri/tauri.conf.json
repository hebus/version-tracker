{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "version-tracker",
  "version": "0.1.2",
  "identifier": "com.sinequa.versiontracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Version Tracker — @sinequa",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNUM1REI2QjJGQTdCNzIKUldSeWUvcXl0bDFjSG0rMk9TNXo4aWp4VU5pSnFyaW9UQmI3YnlaM1Fpczk3K28xQlFSYzRocEQK",
      "endpoints": [
        "https://github.com/hebus/version-tracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
